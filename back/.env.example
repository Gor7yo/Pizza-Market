# ───────── API (NestJS) environment ─────────
# Copy to back/.env for local development. Every variable is validated on startup (src/config/env.ts).

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# Browser origins allowed by CORS and the CSRF origin check (comma-separated)
WEB_ORIGIN=http://localhost:3000
# Public URL of the web app (e-mail links, OAuth redirects)
PUBLIC_WEB_URL=http://localhost:3000
# Number of reverse proxies in front of the API (the Next.js rewrite counts as one)
TRUST_PROXY=1

# docker-compose publishes PostgreSQL on host port 5433
DATABASE_URL=postgresql://market:market@localhost:5433/market
REDIS_URL=redis://localhost:6379/0

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CODE_HMAC_SECRET=change-me-dev-only-hmac-secret-at-least-32-chars
# Defaults to true in production. Keep false for http://localhost.
COOKIE_SECURE=false
# COOKIE_DOMAIN=

STORE_CURRENCY=AMD
STORE_TIMEZONE=Asia/Yerevan

# Google OAuth (optional - leave empty to hide "Sign in with Google").
# Authorized redirect URI in Google Cloud Console must be exactly GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# console = print e-mails to the log (dev only); resend = real delivery
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Tonir Pizza <no-reply@example.com>

# S3-compatible storage (SeaweedFS from docker-compose in development;
# keys match docker/seaweedfs/s3.json). Any S3 provider works in production.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=market
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:8333/market
# create the bucket on startup if missing (development only)
S3_AUTO_CREATE_BUCKET=true

PAYMENT_PROVIDER=mock

# nominatim (OpenStreetMap, no key) | none
GEOCODER_PROVIDER=nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=tonir-pizza-dev/1.0 (you@example.com)

SWAGGER_ENABLED=true
# Exposes /api/v1/dev/emails for E2E tests. Forbidden in production.
DEV_ENDPOINTS_ENABLED=true
